# Copy to .env only when you need non-default local settings. Never commit .env.
# With no .env, `npm start` runs the local evaluation environment on http://localhost:3000.

RAIL=mock                  # mock | testnet. Mainnet settlement is intentionally disabled.
SIGNER=outlayer            # OutLayer custody signs testnet settlements.
PORT=3000
BERRY_DB_PATH=data/berry.sqlite

# Demo session is for local/testnet demonstrations. Wallet signature sign-in is
# the next production-authentication milestone.
AUTH_MODE=demo
OWNER_ACCOUNT=you.near
DEMO_WALLET=you.near
TREASURY_ACCOUNT=berry-treasury.mock.near

# NEAR AI Cloud default. Leave the key blank until you create one in its console.
# With no key, Berry Firm uses a clearly labelled deterministic policy fallback.
AI_BASE_URL=https://cloud-api.near.ai/v1
AI_API_KEY=
AI_MODEL=z-ai/glm-5.3-flash
AI_INPUT_COST_PER_1M=0.08  # USD per 1M input tokens at current GLM Flash rates.
AI_CACHE_READ_COST_PER_1M=0.012 # USD per 1M cached input tokens.
AI_OUTPUT_COST_PER_1M=0.50 # USD per 1M output tokens; update when changing models.
AI_MAX_INPUT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=256

# Policy-gate limits, in USDC.
DAILY_PAYOUT_CAP=1000
DAILY_AI_CAP=5

# Testnet treasury. `npm run wallet:testnet -- <your-account.testnet>` creates a
# custody wallet, saves its wk_ credential here, and selects these testnet values.
# Claim free gas at https://near-faucet.io/ for TREASURY_ACCOUNT, then run
# `npm run wallet:testnet:prepare` to register treasury storage for Circle test USDC.
# Official Circle USDC contract on NEAR Testnet.
USDC_CONTRACT=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
OUTLAYER_API=https://testnet-api.outlayer.ai
OUTLAYER_WALLET_KEY=
OUTLAYER_POLICY_URL=
OUTLAYER_TIMEOUT_MS=20000

# Optional live challenge checkout. 1Click is MAINNET only; leave disabled for
# the free NEAR testnet judge flow. A valid mainnet receiver is required.
NEAR_INTENTS_ENABLED=false
NEAR_INTENTS_API=https://1click.chaindefuser.com
NEAR_INTENTS_API_KEY=
NEAR_INTENTS_RECEIVER=
NEAR_INTENTS_ORIGIN_ASSET=nep141:wrap.near
NEAR_INTENTS_USDC_ASSET=nep141:17208628f84f5d6ad33f0da3bbbeb27ffcb398eac501a31bd6ad2011e36133a1
